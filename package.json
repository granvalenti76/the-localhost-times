{
  "name": "localhost-times",
  "version": "0.1.0",
  "description": "A daily newspaper about your Mac, written by your local LLM. Nothing leaves the machine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/granvalenti76/the-localhost-times.git"
  },
  "homepage": "https://github.com/granvalenti76/the-localhost-times#readme",
  "bugs": "https://github.com/granvalenti76/the-localhost-times/issues",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23 || >=23.4"
  },
  "keywords": [
    "macos",
    "local-first",
    "llm",
    "newspaper",
    "privacy",
    "self-hosted",
    "ollama",
    "llama-cpp"
  ],
  "scripts": {
    "presetup": "node server/preflight.js --setup",
    "setup": "node --disable-warning=ExperimentalWarning server/setup.js",
    "prestart": "node server/preflight.js",
    "start": "vite build --logLevel warn && node --disable-warning=ExperimentalWarning server/index.js",
    "predemo": "node server/preflight.js --demo",
    "demo": "vite build --logLevel warn && node --disable-warning=ExperimentalWarning server/index.js --demo",
    "predev": "node server/preflight.js",
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "probe": "node --disable-warning=ExperimentalWarning server/cli.js probe",
    "collect": "node --disable-warning=ExperimentalWarning server/cli.js collect",
    "print": "node --disable-warning=ExperimentalWarning server/cli.js print",
    "rebuild": "node --disable-warning=ExperimentalWarning server/cli.js rebuild",
    "photos": "node --disable-warning=ExperimentalWarning server/cli.js photos",
    "notify:test": "node --disable-warning=ExperimentalWarning server/cli.js notify",
    "tip": "node --disable-warning=ExperimentalWarning server/cli.js tip",
    "service:install": "node --disable-warning=ExperimentalWarning server/service.js install",
    "service:start": "node --disable-warning=ExperimentalWarning server/service.js start",
    "service:stop": "node --disable-warning=ExperimentalWarning server/service.js stop",
    "service:restart": "node --disable-warning=ExperimentalWarning server/service.js restart",
    "service:uninstall": "node --disable-warning=ExperimentalWarning server/service.js uninstall",
    "service:status": "node --disable-warning=ExperimentalWarning server/service.js status",
    "service:logs": "node --disable-warning=ExperimentalWarning server/service.js logs",
    "menubar:install": "node --disable-warning=ExperimentalWarning server/menubar.js install",
    "menubar:uninstall": "node --disable-warning=ExperimentalWarning server/menubar.js uninstall"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
