{
  "name": "localhost-times",
  "version": "0.1.0",
  "description": "The Localhost Times — all the news that never left the machine. A local, hourly newspaper written from what your Mac did.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node --disable-warning=ExperimentalWarning server/index.js",
    "demo": "vite build && DAILYMAC_DEMO=1 node --disable-warning=ExperimentalWarning server/index.js",
    "probe": "node --disable-warning=ExperimentalWarning server/cli.js probe",
    "collect": "node --disable-warning=ExperimentalWarning server/cli.js collect",
    "print": "node --disable-warning=ExperimentalWarning server/cli.js print",
    "rebuild": "node --disable-warning=ExperimentalWarning server/cli.js rebuild",
    "photos": "node --disable-warning=ExperimentalWarning server/cli.js photos",
    "service:install": "node --disable-warning=ExperimentalWarning server/service.js install",
    "service:uninstall": "node --disable-warning=ExperimentalWarning server/service.js uninstall",
    "service:status": "node --disable-warning=ExperimentalWarning server/service.js status",
    "service:logs": "node --disable-warning=ExperimentalWarning server/service.js logs",
    "notify:test": "node --disable-warning=ExperimentalWarning server/cli.js notify"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
